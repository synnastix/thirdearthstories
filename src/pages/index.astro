---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('encyclopedia');

const tagColors: Record<string, { bg: string; color: string; edge: string }> = {
  place:    { bg: '#EAF3DE', color: '#3B6D11', edge: '#97C459' },
  faction:  { bg: '#EEEDFE', color: '#3C3489', edge: '#7F77DD' },
  creature: { bg: '#FAECE7', color: '#993C1D', edge: '#F0997B' },
  lore:     { bg: '#FAEEDA', color: '#854F0B', edge: '#EF9F27' },
  person:   { bg: '#E1F5EE', color: '#0F6E56', edge: '#5DCAA5' },
};

const counts = {
  place:    entries.filter(e => e.data.category === 'place').length,
  faction:  entries.filter(e => e.data.category === 'faction').length,
  creature: entries.filter(e => e.data.category === 'creature').length,
  lore:     entries.filter(e => e.data.category === 'lore').length,
  person:   entries.filter(e => e.data.category === 'person').length,
};

const quotes = [
  { text: '"Consistency is the death of the spirit."', attr: '— Em, Wildkin · Recursion' },
  { text: '"I figured as long as I wasn\u2019t dead…I may as well live."', attr: '— Rast, Wizard · Recursion' },
];

const featuredPool = entries.map(e => ({
  slug: e.slug,
  title: e.data.title,
  category: e.data.category,
  lead: e.data.lead,
  bg: tagColors[e.data.category]?.bg ?? '#eee',
  color: tagColors[e.data.category]?.color ?? '#666',
}));
---
<Base title="Home">
  <div class="page">

    <div class="hero">
      <div class="hero-text">
        <p class="eyebrow">World compendium</p>
        <h1 class="site-title">Third Earth Stories</h1>
        <p class="site-desc">A living encyclopedia of places, peoples, and powers.</p>
        <div class="stats">
          <div class="stat"><span class="stat-num" data-target={entries.length}>0</span><span class="stat-label">Total</span></div>
          <div class="stat"><span class="stat-num" data-target={counts.place}>0</span><span class="stat-label" style="color:#3B6D11;">Places</span></div>
          <div class="stat"><span class="stat-num" data-target={counts.faction}>0</span><span class="stat-label" style="color:#3C3489;">Factions</span></div>
          <div class="stat"><span class="stat-num" data-target={counts.creature}>0</span><span class="stat-label" style="color:#993C1D;">Creatures</span></div>
          <div class="stat"><span class="stat-num" data-target={counts.lore}>0</span><span class="stat-label" style="color:#854F0B;">Lore</span></div>
          <div class="stat"><span class="stat-num" data-target={counts.person}>0</span><span class="stat-label" style="color:#0F6E56;">People</span></div>
        </div>
      </div>
      <a href="/thirdearthstories/maps" class="map-teaser">
        <img src="/thirdearthstories/images/tellunis.jpg" alt="Map of Tellunis" />
        <div class="map-teaser-bar">Explore the maps →</div>
      </a>
    </div>

    <div class="quote-band">
      <div class="quote-slide" id="quotebox">
        <p class="quote-text" id="qtext">{quotes[0].text}</p>
        <p class="quote-attr" id="qattr">{quotes[0].attr}</p>
      </div>
    </div>

    <div class="body">
      <aside class="sidebar">
        <div class="sidebar-section">
          <div class="sidebar-heading">Browse by type</div>
          <a class="sidebar-item" href="#" data-filter="all">All entries</a>
          <a class="sidebar-item" href="#" data-filter="place">Places</a>
          <a class="sidebar-item" href="#" data-filter="faction">Factions</a>
          <a class="sidebar-item" href="#" data-filter="creature">Creatures</a>
          <a class="sidebar-item" href="#" data-filter="lore">Lore &amp; magic</a>
          <a class="sidebar-item" href="#" data-filter="person">People</a>
        </div>
      </aside>

      <main class="main">
        <p class="section-label">From the archives</p>
        <div class="featured" id="featured">
          <span class="tag" id="ftag"></span>
          <div class="featured-title" id="fname"></div>
          <p class="featured-lead" id="flead"></p>
          <div class="featured-actions">
            <a href="#" id="fread" class="featured-read">Read entry →</a>
            <button id="fshuffle" class="featured-shuffle">⤨ Shuffle</button>
          </div>
        </div>

        <div class="search-bar">
          <input type="text" id="search" placeholder="Search entries…" autocomplete="off" />
        </div>
        <p class="section-label" id="section-label">All entries</p>
        <div class="grid" id="entry-grid">
          {entries.map(entry => {
            const tag = tagColors[entry.data.category] ?? { bg: '#eee', color: '#666', edge: '#ccc' };
            return (
              <a href={`/thirdearthstories/encyclopedia/${entry.slug}`} class="card" style={`border-top-color:${tag.edge};`} data-category={entry.data.category} data-title={entry.data.title} data-lead={entry.data.lead}>
                <span class="tag" style={`background:${tag.bg};color:${tag.color};`}>{entry.data.category}</span>
                <div class="card-title">{entry.data.title}</div>
                <div class="card-desc">{entry.data.lead}</div>
              </a>
            );
          })}
        </div>
        <p class="no-results" id="no-results" style="display:none;">No entries found.</p>
      </main>
    </div>
  </div>
</Base>

<style>
.page {
  background: #f7f5f0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.hero {
  background: #fff;
  border-bottom: 0.5px solid #ddd9d0;
  padding: 3rem 2rem 2.5rem;
  display: flex;
  gap: 3rem;
  align-items: flex-start;
}
.hero-text { flex: 1; }
.eyebrow {
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #999;
  margin-bottom: .75rem;
}
.site-title {
  font-family: 'Crimson Pro', serif;
  font-size: 48px;
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: .75rem;
}
.site-desc {
  font-size: 15px;
  line-height: 1.8;
  color: #666;
  max-width: 520px;
  margin-bottom: 1.75rem;
}
.stats { display: flex; gap: 2rem; flex-wrap: wrap; }
.stat { display: flex; flex-direction: column; }
.stat-num {
  font-family: 'Crimson Pro', serif;
  font-size: 28px;
  font-weight: 300;
}
.stat-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #999;
  margin-top: 2px;
}

.map-teaser {
  width: 260px;
  flex-shrink: 0;
  border: 0.5px solid #ddd9d0;
  border-radius: 12px;
  overflow: hidden;
  display: block;
  text-decoration: none;
  transition: transform .18s ease;
}
.map-teaser:hover { transform: translateY(-3px); }
.map-teaser img {
  width: 100%;
  aspect-ratio: 3/2;
  object-fit: cover;
  display: block;
}
.map-teaser-bar {
  padding: 8px 12px;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #666;
  background: #fff;
  border-top: 0.5px solid #ddd9d0;
}

.quote-band {
  background: #f7f5f0;
  border-bottom: 0.5px solid #ddd9d0;
  padding: 14px 2rem;
  text-align: center;
  min-height: 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.quote-slide { transition: opacity .6s ease; }
.quote-text {
  font-family: 'Crimson Pro', serif;
  font-size: 17px;
  font-style: italic;
  font-weight: 300;
  color: #1a1a18;
}
.quote-attr {
  font-size: 11px;
  letter-spacing: .06em;
  color: #999;
  margin-top: 2px;
}

.body {
  display: grid;
  grid-template-columns: 200px 1fr;
  flex: 1;
}

.sidebar {
  background: #fff;
  border-right: 0.5px solid #ddd9d0;
  padding: 1.5rem 0;
  position: sticky;
  top: 52px;
}
.sidebar-heading {
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #aaa;
  padding: 0 1.25rem;
  margin-bottom: .5rem;
}
.sidebar-item {
  display: block;
  padding: .35rem 1.25rem;
  margin-bottom: .5rem;
}
.sidebar-item {
  display: block;
  padding: .35rem 1.25rem;
  font-size: 13px;
  color: #666;
  text-decoration: none;
}
.sidebar-item:hover { color: #1a1a18; background: #f7f5f0; }

.main {
  padding: 2.5rem 3rem;
  max-width: 780px;
}

.back {
  font-size: 12px;
  color: #aaa;
  text-decoration: none;
  display: inline-block;
  margin-bottom: 1.5rem;
}
.back:hover { color: #1a1a18; }

.article-header {
  padding-bottom: 1.5rem;
  border-bottom: 0.5px solid #ddd9d0;
  margin-bottom: 1.5rem;
}
.tag {
  display: inline-block;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 20px;
  margin-bottom: .75rem;
}
.article-title {
  font-family: 'Crimson Pro', serif;
  font-size: 40px;
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: .75rem;
}
.article-lead {
  font-size: 15px;
  line-height: 1.8;
  color: #666;
  font-style: italic;
  max-width: 580px;
}

.article-body {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}

.article-image {
  margin-bottom: 2rem;
  border-radius: 8px;
  overflow: hidden;
  border: 0.5px solid #ddd9d0;
}
.article-image img {
  width: 100%;
  height: auto;
  display: block;
}

.meta-panel {
  flex-shrink: 0;
  width: 168px;
  background: #f7f5f0;
  border: 0.5px solid #ddd9d0;
  border-radius: 8px;
  padding: 1rem 1.25rem;
  order: 2;
}
.meta-row { margin-bottom: .6rem; }
.meta-row:last-child { margin-bottom: 0; }
.meta-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #aaa;
  margin-bottom: 2px;
}
.meta-value { font-size: 12px; color: #333; }

.prose {
  flex: 1;
  order: 1;
  font-size: 14px;
  line-height: 1.85;
  color: #444;
}
.prose :global(h2) {
  font-family: 'Crimson Pro', serif;
  font-size: 22px;
  font-weight: 400;
  margin: 1.75rem 0 .6rem;
  color: #1a1a18;
  padding-bottom: .3rem;
  border-bottom: 2px solid var(--edge-color, #ddd9d0);
}
.prose :global(h3) {
  font-family: 'Crimson Pro', serif;
  font-size: 18px;
  font-weight: 400;
  margin: 1.5rem 0 .5rem;
  color: #1a1a18;
}
.prose :global(h4) {
  font-family: 'Crimson Pro', serif;
  font-size: 15px;
  font-weight: 400;
  margin: 1.25rem 0 .4rem;
  color: #1a1a18;
}
.prose :global(p) { margin-bottom: 1rem; }
.prose :global(em) { font-style: italic; }
.prose :global(strong) { font-weight: 500; color: #1a1a18; }

.prose :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin: 1.5rem 0;
}
.prose :global(th) {
  text-align: left;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #999;
  padding: .5rem .75rem;
  border-bottom: 0.5px solid #ddd9d0;
}
.prose :global(td) {
  padding: .5rem .75rem;
  border-bottom: 0.5px solid #ddd9d0;
  color: #444;
  vertical-align: top;
}

.related {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 0.5px solid #ddd9d0;
}
.related-label {
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #aaa;
  margin-bottom: .75rem;
}
.related-links { display: flex; flex-wrap: wrap; gap: .5rem; }
.related-link {
  font-size: 12px;
  padding: 4px 10px;
  border: 0.5px solid #ccc;
  border-radius: 20px;
  color: #666;
  text-decoration: none;
  text-transform: capitalize;
}
.related-link:hover { background: #fff; color: #1a1a18; border-color: #aaa; }

@media (max-width: 640px) {
  .body {
    grid-template-columns: 1fr;
  }
  .sidebar {
    position: static;
    height: auto;
    border-right: none;
    border-bottom: 0.5px solid #ddd9d0;
    padding: 1rem 0;
  }
  .main {
    padding: 1.5rem 1.25rem;
  }
  .article-body {
    flex-direction: column;
  }
  .meta-panel {
    width: 100%;
    order: 2;
    margin-top: 1.5rem;
  }
  .prose {
    order: 1;
  }
}
</style>
