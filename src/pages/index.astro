---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';

const entries = await getCollection('encyclopedia');

const tagColors: Record<string, { bg: string; color: string; edge: string }> = {
  place:    { bg: 'var(--place-bg)', color: 'var(--place-text)', edge: 'var(--place-edge)' },
  faction:  { bg: 'var(--faction-bg)', color: 'var(--faction-text)', edge: 'var(--faction-edge)' },
  creature: { bg: 'var(--creature-bg)', color: 'var(--creature-text)', edge: 'var(--creature-edge)' },
  lore:     { bg: 'var(--lore-bg)', color: 'var(--lore-text)', edge: 'var(--lore-edge)' },
  person:   { bg: 'var(--person-bg)', color: 'var(--person-text)', edge: 'var(--person-edge)' },
};

const counts = {
  place:    entries.filter(e => e.data.category === 'place').length,
  faction:  entries.filter(e => e.data.category === 'faction').length,
  creature: entries.filter(e => e.data.category === 'creature').length,
  lore:     entries.filter(e => e.data.category === 'lore').length,
  person:   entries.filter(e => e.data.category === 'person').length,
};

const quotesRaw = fs.readFileSync('src/content/quotes.md', 'utf-8');
const quotes = quotesRaw
  .split('---')
  .map(block => block.trim())
  .filter(block => block.length > 0)
  .map(block => {
    const lines = block.split('\n').map(l => l.trim()).filter(Boolean);
    return { text: lines[0], attr: lines[1] };
  });

const hasQuotes = quotes.length > 0;

const featuredPool = entries.map(e => ({
  slug: e.slug,
  title: e.data.title,
  category: e.data.category,
  lead: e.data.lead,
  bg: tagColors[e.data.category]?.bg ?? 'var(--bg-surface-alt)',
  color: tagColors[e.data.category]?.color ?? 'var(--text-secondary)',
}));
---
<Base title="Home">
  <div class="page">

    <div class="hero">
      <div class="hero-text">
        <p class="eyebrow">World compendium</p>
        <h1 class="site-title">Third Earth Stories</h1>
        <p class="site-desc">A living encyclopedia of places, peoples, and powers.</p>
        <div class="stats">
          <div class="stat"><span class="stat-num" data-target={entries.length}>0</span><span class="stat-label">Total</span></div>
          <div class="stat"><span class="stat-num" data-target={counts.place}>0</span><button type="button" class="stat-label stat-filter" data-filter="place" style="color:var(--place-text);">Places</button></div>
          <div class="stat"><span class="stat-num" data-target={counts.faction}>0</span><button type="button" class="stat-label stat-filter" data-filter="faction" style="color:var(--faction-text);">Factions</button></div>
          <div class="stat"><span class="stat-num" data-target={counts.creature}>0</span><button type="button" class="stat-label stat-filter" data-filter="creature" style="color:var(--creature-text);">Creatures</button></div>
          <div class="stat"><span class="stat-num" data-target={counts.lore}>0</span><button type="button" class="stat-label stat-filter" data-filter="lore" style="color:var(--lore-text);">Lore</button></div>
          <div class="stat"><span class="stat-num" data-target={counts.person}>0</span><button type="button" class="stat-label stat-filter" data-filter="person" style="color:var(--person-text);">People</button></div>
        </div>
      </div>
      <a href="/maps" class="map-teaser">
        <img src="/images/tellunis.jpg" alt="Map of Tellunis" />
        <div class="map-teaser-bar">Explore the maps →</div>
      </a>
    </div>

    {hasQuotes && (
      <div class="quote-band">
        <div class="quote-slide" id="quotebox">
          <p class="quote-text" id="qtext">{quotes[0].text}</p>
          <p class="quote-attr" id="qattr">{quotes[0].attr}</p>
        </div>
      </div>
    )}

    <div class="body">
      <aside class="sidebar">
        <div class="sidebar-section">
          <div class="sidebar-heading">Browse by type</div>
          <a class="sidebar-item" href="#" data-filter="all">All entries</a>
          <a class="sidebar-item" href="#" data-filter="place">Places</a>
          <a class="sidebar-item" href="#" data-filter="faction">Factions</a>
          <a class="sidebar-item" href="#" data-filter="creature">Creatures</a>
          <a class="sidebar-item" href="#" data-filter="lore">Lore &amp; magic</a>
          <a class="sidebar-item" href="#" data-filter="person">People</a>
        </div>
      </aside>

      <main class="main">
        <p class="section-label">From the archives</p>
        <div class="featured" id="featured">
          <span class="tag" id="ftag"></span>
          <div class="featured-title" id="fname"></div>
          <p class="featured-lead" id="flead"></p>
          <div class="featured-actions">
            <a href="#" id="fread" class="featured-read">Read entry →</a>
            <button id="fshuffle" class="featured-shuffle">⤨ Shuffle</button>
          </div>
        </div>

        <div class="search-bar">
          <input type="text" id="search" placeholder="Search entries…" autocomplete="off" />
        </div>
        <p class="section-label" id="section-label">All entries</p>
        <div class="grid" id="entry-grid">
          {entries.map(entry => {
            const tag = tagColors[entry.data.category] ?? { bg: 'var(--bg-surface-alt)', color: 'var(--text-secondary)', edge: 'var(--border)' };
            return (
              <a href={`/encyclopedia/${entry.slug}`} class="card" style={`border-top-color:${tag.edge};`} data-category={entry.data.category} data-title={entry.data.title} data-lead={entry.data.lead}>
                <span class="tag" style={`background:${tag.bg};color:${tag.color};`}>{entry.data.category}</span>
                <div class="card-title">{entry.data.title}</div>
                <div class="card-desc">{entry.data.lead}</div>
              </a>
            );
          })}
        </div>
        <p class="no-results" id="no-results" style="display:none;">No entries found.</p>
      </main>
    </div>
  </div>
</Base>

<style>
.page {
  background: var(--bg-page);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.hero {
  background: var(--bg-surface);
  border-bottom: 0.5px solid var(--border);
  padding: 3rem 2rem 2.5rem;
  display: flex;
  gap: 3rem;
  align-items: flex-start;
}
.hero-text { flex: 1; }
.eyebrow {
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: .75rem;
}
.site-title {
  font-family: 'Crimson Pro', serif;
  font-size: 48px;
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: .75rem;
}
.site-desc {
  font-size: 15px;
  line-height: 1.8;
  color: var(--text-secondary);
  max-width: 520px;
  margin-bottom: 1.75rem;
}
.stats { display: flex; gap: 2rem; flex-wrap: wrap; }
.stat { display: flex; flex-direction: column; }
.stat-num {
  font-family: 'Crimson Pro', serif;
  font-size: 28px;
  font-weight: 300;
}
.stat-label {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--text-muted);
  margin-top: 2px;
}
.stat-filter {
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  text-align: left;
  cursor: pointer;
}
.stat-filter:hover { text-decoration: underline; }
.stat-filter.active { text-decoration: underline; font-weight: 500; }

.map-teaser {
  width: 260px;
  flex-shrink: 0;
  border: 0.5px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  display: block;
  text-decoration: none;
  transition: transform .18s ease;
}
.map-teaser:hover { transform: translateY(-3px); }
.map-teaser img {
  width: 100%;
  aspect-ratio: 3/2;
  object-fit: cover;
  display: block;
}
.map-teaser-bar {
  padding: 8px 12px;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-secondary);
  background: var(--bg-surface);
  border-top: 0.5px solid var(--border);
}

.quote-band {
  background: var(--bg-page);
  border-bottom: 0.5px solid var(--border);
  padding: 14px 2rem;
  text-align: center;
  min-height: 64px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.quote-slide { transition: opacity .6s ease; }
.quote-text {
  font-family: 'Crimson Pro', serif;
  font-size: 17px;
  font-style: italic;
  font-weight: 300;
  color: var(--text-primary);
}
.quote-attr {
  font-size: 11px;
  letter-spacing: .06em;
  color: var(--text-muted);
  margin-top: 2px;
}

.body {
  display: grid;
  grid-template-columns: 200px 1fr;
  flex: 1;
}

.sidebar {
  background: var(--bg-surface);
  border-right: 0.5px solid var(--border);
  padding: 1.5rem 0;
  position: sticky;
  top: 52px;
}
.sidebar-heading {
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-faint);
  padding: 0 1.25rem;
  margin-bottom: .5rem;
}
.sidebar-item {
  display: block;
  padding: .35rem 1.25rem;
  font-size: 13px;
  color: var(--text-secondary);
  text-decoration: none;
  border-left: 2px solid transparent;
}
.sidebar-item:hover { color: var(--text-primary); background: var(--bg-surface-alt); }
.sidebar-item.active {
  color: var(--text-primary);
  background: var(--bg-surface-alt);
  border-left-color: var(--text-primary);
  padding-left: calc(1.25rem - 2px);
}

.main { padding: 2rem 2.5rem; }
.section-label {
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 1rem;
  padding-bottom: .5rem;
  border-bottom: 0.5px solid var(--border);
}

.featured {
  background: var(--bg-surface);
  border: 0.5px solid var(--border);
  border-left: 4px solid var(--text-muted);
  border-radius: 12px;
  padding: 1.5rem 1.75rem;
  margin-bottom: 2rem;
  cursor: pointer;
  transition: opacity .4s ease;
}
.featured:hover {
  transform: translateY(-3px);
}
.featured-title {
  font-family: 'Crimson Pro', serif;
  font-size: 26px;
  font-weight: 400;
  margin: .5rem 0 .35rem;
}
.featured-lead {
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: 1rem;
  max-width: 560px;
}
.featured-actions { display: flex; gap: 14px; align-items: center; }
.featured-read {
  font-size: 12px;
  color: var(--link);
  text-decoration: none;
}
.featured-read:hover { text-decoration: underline; }
.featured-shuffle {
  font-size: 12px;
  padding: 4px 12px;
  border: 0.5px solid var(--border);
  border-radius: 20px;
  background: none;
  color: var(--text-secondary);
  cursor: pointer;
  font-family: 'Inter', sans-serif;
}
.featured-shuffle:hover { background: var(--bg-surface-alt); color: var(--text-primary); }

.search-bar {
  margin-bottom: 1rem;
}
.search-bar input {
  width: 100%;
  padding: 8px 12px;
  font-size: 14px;
  border: 0.5px solid var(--border);
  border-radius: 8px;
  background: var(--bg-surface);
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
}
.search-bar input:focus {
  outline: none;
  border-color: var(--border-strong);
}
.no-results {
  font-size: 13px;
  color: var(--text-faint);
  padding: 1rem 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1rem;
}
.card {
  background: var(--bg-surface);
  padding: 1.25rem;
  display: block;
  text-decoration: none;
  color: inherit;
  border: 0.5px solid var(--border);
  border-top: 3px solid var(--border);
  border-radius: 12px;
  transition: transform .18s ease;
}
.card:hover { transform: translateY(-3px); background: var(--bg-surface-hover); }
.card.hidden { display: none; }

.tag {
  display: inline-block;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 20px;
  margin-bottom: .6rem;
}
.card-title {
  font-family: 'Crimson Pro', serif;
  font-size: 18px;
  margin-bottom: .3rem;
  line-height: 1.2;
}
.card-desc {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.6;
}

@media (max-width: 640px) {
  .hero {
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem 1.25rem 1.5rem;
  }
  .map-teaser { width: 100%; }
  .site-title { font-size: 36px; }
  .stats { gap: 1.25rem; }
  .body { grid-template-columns: 1fr; }
  .sidebar {
    position: static;
    height: auto;
    border-right: none;
    border-bottom: 0.5px solid var(--border);
    padding: 1rem 0;
  }
  .main { padding: 1.5rem 1.25rem; }
  .quote-band { padding: 12px 1.25rem; }
  .featured {
    padding: 1.25rem 1.5rem;
  }
  .featured-title {
    font-size: 22px;
  }
  .featured-actions {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .featured-shuffle {
    width: 100%;
    text-align: center;
  }
}
</style>

<script define:vars={{ featuredPool, quotes }}>
  document.querySelectorAll('.stat-num').forEach(el => {
    const target = parseInt(el.dataset.target ?? '0', 10);
    let n = 0;
    const step = Math.max(1, Math.ceil(target / 30));
    const t = setInterval(() => {
      n = Math.min(n + step, target);
      el.textContent = n;
      if (n >= target) clearInterval(t);
    }, 30);
  });

  let qi = 0;
  if (quotes.length > 1) {
    setInterval(() => {
      const box = document.getElementById('quotebox');
      box.style.opacity = '0';
      setTimeout(() => {
        qi = (qi + 1) % quotes.length;
        document.getElementById('qtext').textContent = quotes[qi].text;
        document.getElementById('qattr').textContent = quotes[qi].attr;
        box.style.opacity = '1';
      }, 600);
    }, 8000);
  }

  let fi = Math.floor(Math.random() * featuredPool.length);

  function renderFeatured(animate) {
    const card = document.getElementById('featured');
    const apply = () => {
      const e = featuredPool[fi];
      const tag = document.getElementById('ftag');
      tag.textContent = e.category;
      tag.style.background = e.bg;
      tag.style.color = e.color;
      document.getElementById('fname').textContent = e.title;
      document.getElementById('flead').textContent = e.lead;
      document.getElementById('fread').href = `/encyclopedia/${e.slug}`;
      card.style.borderLeftColor = e.color;
      card.style.opacity = '1';
    };
    if (animate) {
      card.style.opacity = '0';
      setTimeout(apply, 400);
    } else {
      apply();
    }
  }

  document.getElementById('fshuffle').addEventListener('click', () => {
    let next = Math.floor(Math.random() * featuredPool.length);
    if (next === fi && featuredPool.length > 1) next = (next + 1) % featuredPool.length;
    fi = next;
    renderFeatured(true);
  });

  document.getElementById('featured').addEventListener('click', e => {
    if (e.target.closest('#fshuffle') || e.target.closest('#fread')) return;
    window.location.href = document.getElementById('fread').href;
  });

  renderFeatured(false);

  const cards = Array.from(document.querySelectorAll('.card'));
  const searchInput = document.getElementById('search');
  const label = document.getElementById('section-label');
  const noResults = document.getElementById('no-results');
  const filterTriggers = document.querySelectorAll('[data-filter]');

  const labels = {
    all: 'All entries', place: 'Places', faction: 'Factions',
    creature: 'Creatures', lore: 'Lore & magic', person: 'People',
  };

  let activeFilter = 'all';

  function matchesSearch(card, query) {
    if (!query) return true;
    const text = `${card.dataset.title} ${card.dataset.lead} ${card.dataset.category}`.toLowerCase();
    return text.includes(query.toLowerCase());
  }

  function update() {
    const query = searchInput.value.trim();
    let visibleCount = 0;

    cards.forEach(card => {
      const matchType = activeFilter === 'all' || card.dataset.category === activeFilter;
      const show = matchType && matchesSearch(card, query);
      card.classList.toggle('hidden', !show);
      if (show) visibleCount++;
    });

    label.textContent = query ? `Results for "${query}"` : (labels[activeFilter] ?? 'All entries');
    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  function filter(type) {
    activeFilter = type;
    filterTriggers.forEach(item => {
      item.classList.toggle('active', item.dataset.filter === type);
    });
    update();
  }

  searchInput.addEventListener('input', update);
  filterTriggers.forEach(item => {
    item.addEventListener('click', e => {
      e.preventDefault();
      filter(item.dataset.filter ?? 'all');
      if (item.classList.contains('stat-filter')) {
        document.getElementById('section-label').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  filter('all');
</script>