---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('encyclopedia');
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const tagColors: Record<string, { bg: string; color: string; edge: string }> = {
  place:    { bg: 'var(--place-bg)', color: 'var(--place-text)', edge: 'var(--place-edge)' },
  faction:  { bg: 'var(--faction-bg)', color: 'var(--faction-text)', edge: 'var(--faction-edge)' },
  creature: { bg: 'var(--creature-bg)', color: 'var(--creature-text)', edge: 'var(--creature-edge)' },
  lore:     { bg: 'var(--lore-bg)', color: 'var(--lore-text)', edge: 'var(--lore-edge)' },
  person:   { bg: 'var(--person-bg)', color: 'var(--person-text)', edge: 'var(--person-edge)' },
};
const tag = tagColors[entry.data.category] ?? { bg: 'var(--bg-surface-alt)', color: 'var(--text-secondary)', edge: 'var(--border)' };
---

<Base title={entry.data.title}>
  <div class="page">
    <div class="body">

      <aside class="sidebar">
        <div class="sidebar-section">
          <div class="sidebar-heading">Browse by type</div>
          <a class="sidebar-item" href="/">All entries</a>
          <a class="sidebar-item" href="/?type=place">Places</a>
          <a class="sidebar-item" href="/?type=faction">Factions</a>
          <a class="sidebar-item" href="/?type=creature">Creatures</a>
          <a class="sidebar-item" href="/?type=lore">Lore &amp; magic</a>
          <a class="sidebar-item" href="/?type=person">People</a>
        </div>
      </aside>

      <main class="main">
        <a href="/" class="back">← Encyclopedia</a>

        <div class="article-header" style={`border-left: 4px solid ${tag.edge}; padding-left: 1.25rem;`}>
          <span class="tag" style={`background:${tag.bg};color:${tag.color};`}>{entry.data.category}</span>
          <h1 class="article-title">{entry.data.title}</h1>
          <p class="article-lead">{entry.data.lead}</p>
        </div>

        {entry.data.image && (
          <div class="article-image">
            <img src={entry.data.image} alt={entry.data.title} />
          </div>
        )}

        <div class="article-body">
          {entry.data.meta && (
            <aside class="meta-panel">
              {Object.entries(entry.data.meta).map(([k, v]) => (
                <div class="meta-row">
                  <div class="meta-label">{k}</div>
                  <div class="meta-value">{v}</div>
                </div>
              ))}
            </aside>
          )}
          <div class="prose" style={`--edge-color:${tag.edge};`}>
            <Content />
          </div>
        </div>

        {entry.data.related && entry.data.related.length > 0 && (
          <div class="related">
            <p class="related-label">See also</p>
            <div class="related-links">
              {entry.data.related.map(r => (
                <a href={`/encyclopedia/${r}`} class="related-link">
                  {r.replace(/-/g, ' ')}
                </a>
              ))}
            </div>
          </div>
        )}
      </main>

    </div>
  </div>
</Base>

<style>
.page {
  background: var(--bg-page);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.body {
  display: grid;
  grid-template-columns: 200px 1fr;
  flex: 1;
}

.sidebar {
  background: var(--bg-surface);
  border-right: 0.5px solid var(--border);
  padding: 1.5rem 0;
  position: sticky;
  top: 52px;
}
.sidebar-heading {
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-faint);
  padding: 0 1.25rem;
  margin-bottom: .5rem;
}
.sidebar-item {
  display: block;
  padding: .35rem 1.25rem;
  font-size: 13px;
  color: var(--text-secondary);
  text-decoration: none;
}
.sidebar-item:hover { color: var(--text-primary); background: var(--bg-surface-alt); }

.main {
  padding: 2.5rem 3rem;
  max-width: 780px;
}

.back {
  font-size: 12px;
  color: var(--text-faint);
  text-decoration: none;
  display: inline-block;
  margin-bottom: 1.5rem;
}
.back:hover { color: var(--text-primary); }

.article-header {
  padding-bottom: 1.5rem;
  border-bottom: 0.5px solid var(--border);
  margin-bottom: 1.5rem;
}
.tag {
  display: inline-block;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 20px;
  margin-bottom: .75rem;
}
.article-title {
  font-family: 'Crimson Pro', serif;
  font-size: 40px;
  font-weight: 300;
  line-height: 1.15;
  margin-bottom: .75rem;
}
.article-lead {
  font-size: 15px;
  line-height: 1.8;
  color: var(--text-secondary);
  font-style: italic;
  max-width: 580px;
}

.article-body {
  display: flex;
  gap: 2rem;
  align-items: flex-start;
}

.article-image {
  margin-bottom: 2rem;
  border-radius: 8px;
  overflow: hidden;
  border: 0.5px solid var(--border);
}
.article-image img {
  width: 100%;
  height: auto;
  display: block;
}

.meta-panel {
  flex-shrink: 0;
  width: 168px;
  background: var(--bg-surface-alt);
  border: 0.5px solid var(--border);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  order: 2;
}
.meta-row { margin-bottom: .6rem; }
.meta-row:last-child { margin-bottom: 0; }
.meta-label {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: var(--text-faint);
  margin-bottom: 2px;
}
.meta-value { font-size: 12px; color: var(--text-primary); }

.prose {
  flex: 1;
  order: 1;
  font-size: 14px;
  line-height: 1.85;
  color: var(--text-secondary);
}
.prose :global(h2) {
  font-family: 'Crimson Pro', serif;
  font-size: 22px;
  font-weight: 400;
  margin: 1.75rem 0 .6rem;
  color: var(--text-primary);
  padding-bottom: .3rem;
  border-bottom: 2px solid var(--edge-color, var(--border));
}
.prose :global(h3) {
  font-family: 'Crimson Pro', serif;
  font-size: 18px;
  font-weight: 400;
  margin: 1.5rem 0 .5rem;
  color: var(--text-primary);
}
.prose :global(h4) {
  font-family: 'Crimson Pro', serif;
  font-size: 15px;
  font-weight: 400;
  margin: 1.25rem 0 .4rem;
  color: var(--text-primary);
}
.prose :global(p) { margin-bottom: 1rem; }
.prose :global(em) { font-style: italic; }
.prose :global(strong) { font-weight: 500; color: var(--text-primary); }

.prose :global(table) {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  margin: 1.5rem 0;
}
.prose :global(th) {
  text-align: left;
  font-size: 10px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding: .5rem .75rem;
  border-bottom: 0.5px solid var(--border);
}
.prose :global(td) {
  padding: .5rem .75rem;
  border-bottom: 0.5px solid var(--border);
  color: var(--text-secondary);
  vertical-align: top;
}

.related {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 0.5px solid var(--border);
}
.related-label {
  font-size: 11px;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: .75rem;
}
.related-links { display: flex; flex-wrap: wrap; gap: .5rem; }
.related-link {
  font-size: 12px;
  padding: 4px 10px;
  border: 0.5px solid var(--border);
  border-radius: 20px;
  color: var(--text-secondary);
  text-decoration: none;
  text-transform: capitalize;
}
.related-link:hover { background: var(--bg-surface); color: var(--text-primary); border-color: var(--border-strong); }

@media (max-width: 640px) {
  .body {
    grid-template-columns: 1fr;
  }
  .sidebar {
    position: static;
    height: auto;
    border-right: none;
    border-bottom: 0.5px solid var(--border);
    padding: 1rem 0;
  }
  .main {
    padding: 1.5rem 1.25rem;
  }
  .article-body {
    flex-direction: column;
  }
  .meta-panel {
    width: 100%;
    order: 2;
    margin-top: 1.5rem;
  }
  .prose {
    order: 1;
  }
}
</style>