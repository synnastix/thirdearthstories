---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const about = await getEntry('about', 'index');
const { Content } = await about.render();
---
<Base title="About">
  <div class="about">
    <p class="eyebrow">About</p>
    <h1 class="page-title">Third Earth Stories</h1>

    <div class="body-text">
      <Content />
    </div>
  </div>
</Base>

<style>
  .about {
    max-width: 740px;
    margin: 3rem auto;
    padding: 0 2rem;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: .75rem;
  }
  .page-title {
    font-family: 'Crimson Pro', serif;
    font-size: 40px;
    font-weight: 300;
    margin-bottom: 2rem;
  }
  .body-text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .body-text :global(h2) {
    font-family: 'Crimson Pro', serif;
    font-size: 22px;
    font-weight: 400;
    color: var(--text-primary);
    margin: 2rem 0 .75rem;
    padding-bottom: .3rem;
    border-bottom: 0.5px solid var(--border);
  }
  .body-text :global(h2:first-child) {
    margin-top: 0;
  }
  .body-text :global(p) {
    margin-bottom: 1rem;
  }
  .body-text :global(a) {
    color: var(--link);
    text-decoration: underline;
  }
</style>
