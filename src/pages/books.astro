---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const bookEntries = (await getCollection('books')).sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
);

const books = bookEntries.map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  cover: entry.data.cover,
  isbn: entry.data.isbn,
  release: entry.data.release,
  links: entry.data.links,
}));
---

<Base title="Books">
  <div class="page">
    <div class="hero">
      <p class="eyebrow">Bibliography</p>
      <h1 class="page-title">Books</h1>
      <p class="page-desc">Published works set in the world of Third Earth Stories.</p>
    </div>

    {books.length > 0 ? (
      <div class="gallery">
        {books.map(book => (
          <div class="book-card">
            <div class="book-cover">
              <img src={book.cover} alt={book.title} />
            </div>
            <div class="book-info">
              <div class="book-title">{book.title}</div>
              <p class="book-desc">{book.description}</p>
              {book.release && <p class="book-release">{book.release}</p>}
              {book.isbn && <p class="book-isbn">ISBN {book.isbn}</p>}
              <div class="book-links">
                {book.links.map(link => (
                  <a href={link.url} class="book-link" target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty-state">No books published yet — check back soon.</p>
    )}
  </div>
</Base>

<style>
  .page { background: var(--bg-page); min-height: 100vh; display: flex; flex-direction: column; }

  .hero {
    background: var(--bg-surface);
    border-bottom: 0.5px solid var(--border);
    padding: 3rem 2rem 2.5rem;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: .75rem;
  }
  .page-title {
    font-family: 'Crimson Pro', serif;
    font-size: 48px;
    font-weight: 300;
    line-height: 1.15;
    margin-bottom: .75rem;
  }
  .page-desc {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
    font-style: italic;
  }

  .empty-state {
    font-size: 14px;
    color: var(--text-muted);
    padding: 3rem 2rem;
    text-align: center;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    padding: 2.5rem 2rem;
  }

  .book-card {
    background: var(--bg-surface);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .book-cover {
    aspect-ratio: 2/3;
    overflow: hidden;
    border-bottom: 0.5px solid var(--border);
  }
  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-info {
    padding: 1rem 1.25rem 1.25rem;
  }
  .book-title {
    font-family: 'Crimson Pro', serif;
    font-size: 20px;
    font-weight: 400;
    margin-bottom: .35rem;
    line-height: 1.2;
  }
  .book-desc {
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: .6rem;
  }
  .book-release {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: .02em;
    margin-bottom: .3rem;
  }
  .book-isbn {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: .02em;
    margin-bottom: .85rem;
  }

  .book-links {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }
  .book-link {
    font-size: 12px;
    padding: 4px 12px;
    border: 0.5px solid var(--border);
    border-radius: 20px;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .book-link:hover {
    background: var(--bg-surface-alt);
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  @media (max-width: 640px) {
    .gallery { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); padding: 1.5rem 1.25rem; }
    .hero { padding: 2rem 1.25rem 1.5rem; }
    .page-title { font-size: 36px; }
  }
</style>
