---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const mapEntries = (await getCollection('maps')).sort(
  (a, b) => (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER)
);

const maps = mapEntries.map(entry => ({
  title: entry.data.title,
  description: entry.data.description,
  image: entry.data.image,
}));
---

<Base title="Maps">
  <div class="page">
    <div class="hero">
      <p class="eyebrow">Cartography</p>
      <h1 class="page-title">Maps</h1>
      <p class="page-desc">Known surveys of the world. Pieced together from stories and exploration, accuracy not guaranteed.</p>
    </div>

    <div class="gallery">
      {maps.map((map, i) => (
        <div class="map-card" onclick={`openLightbox(${i})`}>
          <div class="map-thumb">
            <img src={map.image} alt={map.title} />
            <div class="map-overlay">
              <span class="map-zoom">View full size</span>
            </div>
          </div>
          <div class="map-info">
            <div class="map-title">{map.title}</div>
            <div class="map-desc">{map.description}</div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="lightbox" id="lightbox" onclick="closeLightbox()">
    <button class="lightbox-close" onclick="event.stopPropagation(); closeLightbox()">✕</button>
    <button class="lightbox-prev" onclick="event.stopPropagation(); changeMap(-1)">‹</button>
    <img class="lightbox-img" id="lightbox-img" src="" alt="" draggable="false" onclick="event.stopPropagation();" />
    <button class="lightbox-next" onclick="event.stopPropagation(); changeMap(1)">›</button>
    <div class="lightbox-caption" id="lightbox-caption"></div>
  </div>
</Base>

<style>
  .page { background: var(--bg-page); min-height: 100vh; display: flex; flex-direction: column; }

  .hero {
    background: var(--bg-surface);
    border-bottom: 0.5px solid var(--border);
    padding: 3rem 2rem 2.5rem;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: .75rem;
  }
  .page-title {
    font-family: 'Crimson Pro', serif;
    font-size: 48px;
    font-weight: 300;
    line-height: 1.15;
    margin-bottom: .75rem;
  }
  .page-desc {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
    font-style: italic;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
    padding: 2.5rem 2rem;
  }

  .map-card {
    background: var(--bg-surface);
    border: 0.5px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
  }
  .map-card:hover .map-overlay { opacity: 1; }
  .map-card:hover img { transform: scale(1.02); }

  .map-thumb {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  .map-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .map-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .map-zoom {
    color: #fff;
    font-size: 13px;
    letter-spacing: .08em;
    text-transform: uppercase;
    border: 1px solid rgba(255,255,255,0.6);
    padding: 6px 16px;
    border-radius: 20px;
  }

  .map-info {
    padding: 1rem 1.25rem;
  }
  .map-title {
    font-family: 'Crimson Pro', serif;
    font-size: 20px;
    font-weight: 400;
    margin-bottom: .25rem;
  }
  .map-desc {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }
  .lightbox.open { display: flex; }

  .lightbox-img {
    max-width: 90vw;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 4px;
    transform-origin: 0 0;
    transition: transform 0.25s ease;
    touch-action: none;
    cursor: zoom-in;
  }
  .lightbox-img.zoomed {
    cursor: grab;
    border-radius: 0;
  }
  .lightbox-img.dragging {
    cursor: grabbing;
    transition: none;
  }
  .lightbox-caption {
    color: rgba(255,255,255,0.6);
    font-size: 13px;
    margin-top: 1rem;
    letter-spacing: .04em;
  }
  .lightbox-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
  }
  .lightbox-close:hover { color: #fff; }

  .lightbox-prev, .lightbox-next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255,255,255,0.6);
    font-size: 48px;
    cursor: pointer;
    line-height: 1;
    padding: 0 1rem;
  }
  .lightbox-prev:hover, .lightbox-next:hover { color: #fff; }
  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }

  @media (max-width: 640px) {
    .gallery { grid-template-columns: 1fr; padding: 1.5rem 1.25rem; }
    .hero { padding: 2rem 1.25rem 1.5rem; }
    .page-title { font-size: 36px; }
  }
</style>

<script define:vars={{ maps }}>
  let current = 0;
  const ZOOM = 3;
  let scale = 1, panX = 0, panY = 0;
  let dragging = false, moved = false;
  let startClientX = 0, startClientY = 0, startPanX = 0, startPanY = 0;

  const lightbox = () => document.getElementById('lightbox');
  const img = () => document.getElementById('lightbox-img');
  const caption = () => document.getElementById('lightbox-caption');

  let baseLeft = 0, baseTop = 0, baseW = 0, baseH = 0;

  function measureBase() {
    const rect = img().getBoundingClientRect();
    baseLeft = rect.left;
    baseTop = rect.top;
    baseW = rect.width;
    baseH = rect.height;
  }

  function clampPan(nextScale, nextPanX, nextPanY) {
    const vw = window.innerWidth, vh = window.innerHeight;
    const scaledW = baseW * nextScale, scaledH = baseH * nextScale;

    let minX, maxX, minY, maxY;
    if (scaledW <= vw) {
      minX = maxX = (vw - scaledW) / 2 - baseLeft;
    } else {
      minX = vw - baseLeft - scaledW;
      maxX = -baseLeft;
    }
    if (scaledH <= vh) {
      minY = maxY = (vh - scaledH) / 2 - baseTop;
    } else {
      minY = vh - baseTop - scaledH;
      maxY = -baseTop;
    }
    return {
      x: Math.min(maxX, Math.max(minX, nextPanX)),
      y: Math.min(maxY, Math.max(minY, nextPanY)),
    };
  }

  function applyTransform() {
    const el = img();
    el.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
    el.classList.toggle('zoomed', scale > 1);
  }

  function resetZoom() {
    scale = 1; panX = 0; panY = 0;
    applyTransform();
    measureBase();
  }

  img().addEventListener('load', resetZoom);
  window.addEventListener('resize', () => {
    if (lightbox().classList.contains('open')) resetZoom();
  });

  window.openLightbox = function(index) {
    current = index;
    const el = img();
    el.src = maps[current].image;
    el.alt = maps[current].title;
    caption().textContent = maps[current].title;
    resetZoom();
    lightbox().classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  window.closeLightbox = function() {
    lightbox().classList.remove('open');
    document.body.style.overflow = '';
  }

  window.changeMap = function(dir) {
    current = (current + dir + maps.length) % maps.length;
    const el = img();
    el.src = maps[current].image;
    el.alt = maps[current].title;
    caption().textContent = maps[current].title;
    resetZoom();
  }

  document.addEventListener('keydown', e => {
    if (!lightbox().classList.contains('open')) return;
    if (e.key === 'Escape') window.closeLightbox();
    if (e.key === 'ArrowLeft') window.changeMap(-1);
    if (e.key === 'ArrowRight') window.changeMap(1);
  });

  function onPointerMove(e) {
    if (!dragging) return;
    const dx = e.clientX - startClientX;
    const dy = e.clientY - startClientY;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
    if (scale > 1) {
      const c = clampPan(scale, startPanX + dx, startPanY + dy);
      panX = c.x; panY = c.y;
      applyTransform();
    }
  }

  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    img().classList.remove('dragging');
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', endDrag);
    window.removeEventListener('pointercancel', endDrag);
    if (!moved) {
      if (scale === 1) {
        const rect = img().getBoundingClientRect();
        const dx0 = e.clientX - rect.left;
        const dy0 = e.clientY - rect.top;
        const nextPanX = panX + dx0 * (1 - ZOOM / scale);
        const nextPanY = panY + dy0 * (1 - ZOOM / scale);
        const c = clampPan(ZOOM, nextPanX, nextPanY);
        scale = ZOOM; panX = c.x; panY = c.y;
      } else {
        scale = 1; panX = 0; panY = 0;
      }
      applyTransform();
    }
  }

  img().addEventListener('pointerdown', e => {
    dragging = true;
    moved = false;
    startClientX = e.clientX;
    startClientY = e.clientY;
    startPanX = panX;
    startPanY = panY;
    img().classList.add('dragging');
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
  });
</script>
